            "value": 118,
            "verified": true
        },
        "commaPauseMs": null,
        "periodPauseMs": null
    },
    "entries": [
        {
            "id": "at",
            "match": "At",
            "replace": {
                "kind": "vtml",
                "markup": "<vtml_phoneme alphabet=\"x-cmu\" ph=\"AE0 T\"></vtml_phoneme>, <vtml_pause time=\"0\"/>"
            },
            "sources": [
                {
                    "source": "tmyk",
                    "page": 4
                }
            ],
            "notes": "Meant for the opening \"At 4:18 PM,\" of warnings; it applies to every \"at\"."
        },
        {
            "id": "hazardous",
            "match": "Hazardous",
            "replace": {
                "kind": "phoneme",
                "ph": "HH AE1 Z ER1 D AH0 S"
            },
            "sources": [
                {
                    "source": "tmyk",
                    "page": 3
                }
            ]
        },
        {
            "id": "severe",
            "match": "Severe",
            "replace": {
                "kind": "phoneme",
                "ph": "S AH0 V IY1 R"
            },
            "sources": [
                {
                    "source": "tmyk",
                    "page": 3
                }
            ]
        }
    ],
    "style": {
        "preamble": "The following is a <vtml_phoneme alphabet=\"x-cmu\" ph=\"S AH0 V IY1 R\"></vtml_phoneme> weather bulletin.",
        "saysOfficeState": {
            "value": true,
            "note": "Not in flood alerts (FLW, FFW)"
        },
        "regionOfState": "No",
        "saysTimeZone": "No (reads 4:45 PM as \"4, 45 PM\"; very short pause after \"At 4:18 PM, A Severe Thunderstorm\")",
        "hazardIndicator": "Hazard",
        "reportScript": null,
        "recap": "Yes (the recap time is read \"Oh 5, 15 PM\")",
        "notes": [
            "Observation introduction: \"these are the 9 am observations for friday, may 22nd.\"",
            "Paul does not pause between the hour and the minute",
            "Individual marine zones are announced",
            "No \"central daylight time\" after the ending time in the alert"
        ]
    }
